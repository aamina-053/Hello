import random

# Distance between cities
cities = {
    'A': {'A': 0, 'B': 10, 'C': 15, 'D': 20},
    'B': {'A': 10, 'B': 0, 'C': 35, 'D': 25},
    'C': {'A': 15, 'B': 35, 'C': 0, 'D': 30},
    'D': {'A': 20, 'B': 25, 'C': 30, 'D': 0}
}

# Calculate route distance
def distance(route):
    return sum(cities[route[i]][route[(i+1) % 4]] for i in range(4))

# Generate new route
def neighbor(route):
    r = route.copy()
    i, j = random.sample(range(4), 2)
    r[i], r[j] = r[j], r[i]
    return r

# Local Beam Search  
def beam_search(k=3):
    beam = [random.sample(list(cities), 4) for _ in range(k)]

    for _ in range(100):
        neighbors = []

        for route in beam:
            for _ in range(5):
                neighbors.append(neighbor(route))

        neighbors.sort(key=distance)
        beam = neighbors[:k]

    best = min(beam, key=distance)
    return best, distance(best)

# Run program
route, cost = beam_search()

print("Best Route:", route + [route[0]])
print("Minimum Distance:", cost)
