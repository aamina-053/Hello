# Goal-Based Agent - Number Guessing Game

print("Think of a number between 0 and 10.")
print("I will try to guess it!")

low = 0
high = 10
guess_count = 0

while low <= high:
    guess = (low + high) // 2
    guess_count += 1

    print("My guess is:", guess)
    feedback = input("Enter feedback (higher/lower/correct): ").lower()

    if feedback == "correct":
        print("I guessed your number:", guess)
        print("Total guesses:", guess_count)
        break

    elif feedback == "higher":
        low = guess + 1

    elif feedback == "lower":
        high = guess - 1

    else:
        print("Invalid input.")
        guess_count -= 1

else:
    print("Inconsistent feedback. Please restart the program.")
