
import heapq

start = (1, 2, 3,
         4, 0, 6,
         7, 5, 8)

goal = (1, 2, 3,
        4, 5, 6,
        7, 8, 0)

# Manhattan Distance
def heuristic(state):
    distance = 0

    for i in range(9):
        if state[i] != 0:
            goal_pos = state[i] - 1

            x, y = i // 3, i % 3
            gx, gy = goal_pos // 3, goal_pos % 3

            distance += abs(x - gx) + abs(y - gy)

    return distance


# A* Search
def astar(start, goal):
    queue = [(heuristic(start), 0, start, [])]
    visited = set()

    while queue:
        f, g, state, path = heapq.heappop(queue)

        if state in visited:
            continue

        visited.add(state)
        path = path + [state]

        if state == goal:
            return path

        zero = state.index(0)
        x, y = zero // 3, zero % 3

        moves = [(x+1, y), (x-1, y),
                 (x, y+1), (x, y-1)]

        for nx, ny in moves:
            if 0 <= nx < 3 and 0 <= ny < 3:
                pos = nx * 3 + ny

                new = list(state)
                new[zero], new[pos] = new[pos], new[zero]
                new = tuple(new)

                if new not in visited:
                    new_g = g + 1
                    new_f = new_g + heuristic(new)

                    heapq.heappush(queue, (new_f, new_g, new, path))

    return None


# Run program
solution = astar(start, goal)

if solution:
    print("Solution Found!")
    print("Total Moves:", len(solution) - 1)

    for state in solution:
        for i in range(0, 9, 3):
            print(state[i:i+3])
        print()
else:
    print("No solution found!")
